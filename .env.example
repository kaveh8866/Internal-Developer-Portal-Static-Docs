# =============================================================================
# Internal Developer Portal — environment template
# =============================================================================
# Copy to `.env` (never committed) and adjust. Every value here is a placeholder:
# no real hostname, token or bucket name belongs in this file.

# --- Portal runtime ----------------------------------------------------------
# Bind address for the published port. 127.0.0.1 keeps the portal local-only;
# on an OCI instance behind a proxy set 0.0.0.0 and close 8080 in the security
# list so only the proxy port is reachable.
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PORT=8080
PORTAL_ENV=development
PORTAL_SITE_URL=https://portal.internal.example.com/
PORTAL_TITLE=CloudGuard Internal Developer Portal
TZ=UTC

# --- Reverse proxy / TLS (Stage 2) -------------------------------------------
# The portal itself speaks plain HTTP on 8080; TLS terminates in front of it.
PORTAL_PROXY_PUBLIC_URL=https://portal.example.invalid
PORTAL_TRUSTED_PROXY_CIDR=10.0.0.0/8
PORTAL_TLS_CERT_PATH=/etc/portal/tls/portal.example.invalid.crt
PORTAL_TLS_KEY_PATH=/etc/portal/tls/portal.example.invalid.key

# --- OCI (Stage 2, OpenTofu) -------------------------------------------------
OCI_REGION=eu-frankfurt-1
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exampleuniqueid
OCI_USER_OCID=ocid1.user.oc1..exampleuniqueid
OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..exampleuniqueid
OCI_AVAILABILITY_DOMAIN=example:EU-FRANKFURT-1-AD-1
OCI_INSTANCE_SHAPE=VM.Standard.A1.Flex
OCI_SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample-placeholder-key portal@example.invalid

# --- Access control (Stage 4) ------------------------------------------------
# The portal is internal: put it behind SSO at the proxy or an allow-list here.
PORTAL_IP_ALLOWLIST=10.0.0.0/8 192.168.0.0/16
PORTAL_BASIC_AUTH_USER=portal-viewer
PORTAL_BASIC_AUTH_PASSWORD=replace-me-before-exposing
